# Builds the package from this working tree (used by bin/install).
pkgname=retake
pkgver=0.1.0
pkgrel=1
pkgdesc="Solo talking recordings with the retakes handled for you"
arch=('any')
url="https://github.com/sergiojrdotnet/retake"
license=('MIT')
depends=(
  'python' 'pyside6' 'qt6-declarative' 'qt6-multimedia' 'qt6-svg'
  'python-numpy' 'python-soundfile' 'python-sounddevice' 'python-soxr'
  'python-vosk' 'python-rapidfuzz' 'python-psutil' 'python-tomli-w'
  'python-platformdirs' 'python-jeepney' 'espeak-ng' 'ffmpeg' 'libpulse'
)
optdepends=(
  'python-pytorch: Silero speech detection and pronunciation scoring on the CPU'
  'python-pytorch-cuda: Silero and pronunciation scoring on NVIDIA GPUs'
  'gpu-screen-recorder: screen + camera recording'
  'scrcpy: Android phone as camera'
  'python-nvidia-ml-py: NVIDIA GPU monitoring'
  'python-websockets: OBS control'
  'python-evdev: exclusive foot pedal input'
)
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel' 'pyside6-tools')

build() {
  cd "$startdir/.."
  rm -rf dist build
  for ts in src/retake/i18n/*.ts; do
    pyside6-lrelease "$ts" -qm "${ts%.ts}.qm"
  done
  python -m build --wheel --no-isolation
}

package() {
  cd "$startdir/.."
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 pkgbuild/retake.desktop "$pkgdir/usr/share/applications/retake.desktop"
  install -Dm644 pkgbuild/retake.xml "$pkgdir/usr/share/mime/packages/retake.xml"
  install -Dm644 src/retake/assets/retake.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/retake.svg"
  install -Dm644 src/retake/assets/retake-symbolic.svg "$pkgdir/usr/share/icons/hicolor/symbolic/apps/retake-symbolic.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
